// Caption writer — saved structure and example voice.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Single-row caption structure and example captions.
model Setting {
  id              Int      @id @default(1)
  captionTemplate String   @default("")
  captionExamples String   @default("")
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}
